  InputLines:
    - '// @ui {"widget":"label", "label":"Drill state machine (TDD §4)"}'
    - '// @ui {"widget":"separator"}'
    - '// @input AssignableType_1 config {"hint":"DrillConfig component with every tunable"}'
    - '// @input AssignableType_2 headPose {"hint":"HeadPose component (camera position and look direction)"}'
    - '// @input AssignableType_3 safetyPanel {"hint":"SafetyPanel component (reminder + Continue)"}'
    - '// @input AssignableType_4 languagePanel {"hint":"LanguagePanel component (picker before SAFETY, Slice 5L; under AftershockRoot, not the Room)"}'
    - "// @input SceneObject room {\"hint\":\"Room root. At start its floor is placed eyeHeight below the head; every BRIEFING moves it to the wearer's spot and heading.\"}"
    - "// @input AssignableType_5 safeZone {\"hint\":\"SafeZone component on the table's marker. Its table and marker are moved by the layout.\"}"
    - '// @input AssignableType_6 cabinetLabel {"hint":"Hazard label on the cabinet"}'
    - '// @input AssignableType_7 shelfLabel {"hint":"Hazard label on the shelf"}'
    - '// @input AssignableType_8 glassLabel {"hint":"Hazard label on the glass window"}'
    - '// @input AssignableType_9 cabinetDanger {"hint":"DangerZone (kind Cabinet) on a child of the Cabinet"}'
    - '// @input AssignableType_10 shelfDanger {"hint":"DangerZone (kind Shelf) on a child of the Shelf"}'
    - '// @input AssignableType_11 glassDanger {"hint":"DangerZone (kind Glass) on a child of the GlassWindow"}'
    - "// @input AssignableType_12 safeZone2 {\"hint\":\"SafeZone component on the second table's marker (SafeZoneMarker2); used when the layout has two tables\"}"
    - '// @input AssignableType_13 lampLabel {"hint":"Hazard label on the floor lamp"}'
    - '// @input AssignableType_14 tvLabel {"hint":"Hazard label on the TV stand"}'
    - '// @input AssignableType_15 lampDanger {"hint":"DangerZone (kind Lamp) on a child of the FloorLamp"}'
    - '// @input AssignableType_16 tvDanger {"hint":"DangerZone (kind TV) on a child of the TvStand"}'
    - '// @input SceneObject bed {"hint":"Bed anchor under the Room, at the floor. Always in the layout; never cover (bed trap, 5j-15)."}'
    - '// @input SceneObject chair {"hint":"Chair anchor under the Room, at the floor. Always in the layout."}'
    - '// @input AssignableType_17 briefingPanel {"hint":"BriefingPanel component (instr.brief)"}'
    - '// @input AssignableType_18 quakeShaker {"hint":"QuakeShaker component on the Room"}'
    - '// @input AssignableType_19 hud {"hint":"Hud component (under AftershockRoot, not the Room, so it never shakes)"}'
    - '// @input AssignableType_20 offscreenArrow {"hint":"OffscreenArrow component (under AftershockRoot, not the Room, so it never shakes)"}'
    - '// @input Component.AudioComponent rumbleAudio {"hint":"AudioComponent with the looping rumble track"}'
    - '// @input AssignableType_21 resultPanel {"hint":"ResultPanel component (result / game-over + Restart, under AftershockRoot)"}'
    - '// @ui {"widget":"group_start", "label":"Scan, path and edge warning (Slice 7B)"}'
    - '// @input AssignableType_22 scanIntro {"hint":"ScanIntro component: the sweep, hazard brackets and n/N chip at the start of BRIEFING"}'
    - "// @input AssignableType_23 floorPath {\"hint\":\"FloorPath component: green chevrons to the target table's safe zone\"}"
    - '// @input AssignableType_24 edgeWarning {"hint":"EdgeWarning component: red view-edge pulse while health drains"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Furniture models (Slice 7R)"}'
    - '// @input Asset.ObjectPrefab tablePrefab {"hint":"Table model (both tables): root at bottom center, cm, front +Z"}'
    - // @input Asset.ObjectPrefab cabinetPrefab
    - // @input Asset.ObjectPrefab shelfPrefab
    - // @input Asset.ObjectPrefab glassPrefab
    - // @input Asset.ObjectPrefab lampPrefab
    - // @input Asset.ObjectPrefab tvPrefab
    - // @input Asset.ObjectPrefab bedPrefab
    - // @input Asset.ObjectPrefab chairPrefab
    - '// @ui {"widget":"group_end"}'
