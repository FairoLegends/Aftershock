  InputLines:
    - '// @ui {"widget":"label", "label":"Aftershock drill tunables (TDD §5)"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Quake timing"}'
    - '// @input float quakeDurationMin = 45 {"hint":"Shortest quake, in seconds"}'
    - '// @input float quakeDurationMax = 60 {"hint":"Longest quake, in seconds"}'
    - '// @input float quakeWaitMin = 8 {"hint":"Shortest random wait before the quake, in seconds"}'
    - '// @input float quakeWaitMax = 15 {"hint":"Longest random wait before the quake, in seconds"}'
    - '// @input float warningShowSeconds = 2.5 {"hint":"How long the warning banner shows, in seconds"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Take cover"}'
    - '// @input float duckDrop = 90 {"hint":"Ducked when head Y is this far below the baseline (cm). 90 puts the head under the 75 cm table top (learner, 27 Oct)."}'
    - '// @input float duckHysteresis = 10 {"hint":"Standing again only above baseline - duckDrop + this (cm)"}'
    - '// @input float safeZoneMargin = 15 {"hint":"Safe zone = table footprint grown by this margin (cm)"}'
    - '// @input float safeHoldSeconds = 1 {"hint":"inZone and ducked must hold this long to count as safe, in seconds"}'
    - '// @input float markerBlinkHz = 2 {"hint":"Safe-zone marker blink rate during the quake, in Hz (DESIGN_BRIEF §6)"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Health"}'
    - '// @input float healthStart = 100 {"hint":"Health at the start of each drill (points)"}'
    - '// @input float healthDrainPerSecond = 4 {"hint":"Health lost per second while exposed (points per second)"}'
    - '// @input float healthAlarmBelow = 30 {"hint":"Health bar turns alarm red below this (points, DESIGN_BRIEF §5.1)"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Shake"}'
    - '// @input float shakeAmplitudeCm = 2.5 {"hint":"Room position shake amplitude (cm)"}'
    - '// @input float shakeTiltDeg = 1.2 {"hint":"Room tilt shake amplitude, in degrees"}'
    - '// @input float shakeFrequencyMinHz = 2 {"hint":"Lowest layered shake frequency, in Hz"}'
    - '// @input float shakeFrequencyMaxHz = 6 {"hint":"Highest layered shake frequency, in Hz"}'
    - '// @input float shakeRampSeconds = 3 {"hint":"Shake ramps up over the first and down over the last this many seconds (DESIGN_BRIEF §6.2)"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"View and HUD"}'
    - '// @input float fovHalfAngleHorizontal = 16 {"hint":"Half the horizontal view angle, in degrees (Specs view about 32°)"}'
    - '// @input float fovHalfAngleVertical = 18.5 {"hint":"Half the vertical view angle, in degrees (Specs view about 37°)"}'
    - '// @input float hudDistance = 110 {"hint":"Distance of panels and HUD in front of the head (cm)"}'
    - '// @input float hudBelowEye = 22 {"hint":"Panels and HUD sit this far below eye level (cm)"}'
    - '// @input float resultBelowEye = 10 {"hint":"Result / game-over panel center sits this far below eye level (cm). Smaller than hudBelowEye so the taller panel, Restart included, stays in view with the head level (ENGINEERING_PLAN 5i item 4)."}'
    - '// @input float pinchGuardSeconds = 0.5 {"hint":"A newly shown panel ignores button presses for this long, in seconds (ENGINEERING_PLAN 5h item 1)"}'
    - '// @input string timerMode = "elapsed" {"hint":"Timer shows elapsed time since the quake started (learner, Q3)", "widget":"combobox", "values":[{"label":"Elapsed", "value":"elapsed"}]}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Room"}'
    - "// @input float eyeHeight = 160 {\"hint\":\"Floor sits this far below the head's start height (cm). The preview starts the head at Y = 0.\"}"
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Fonts"}'
    - '// @input Asset.Font fontJa {"hint":"Japanese font for every ja line (Fonts/NotoSansJP-Aftershock.ttf). The default font has no CJK glyphs."}'
    - '// @input Asset.Font fontZh {"hint":"Simplified Chinese font for every zh line (Fonts/NotoSansSC-Aftershock.ttf)"}'
    - '// @input Asset.Font fontBody {"hint":"Latin font for every id/en/de line, title and number (Fonts/Manrope-Aftershock.ttf, 600; Slice 7A-soft: one family)"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Layout and danger zones"}'
    - '// @input float tableDistanceMin = 120 {"hint":"Closest a table center may be to the start spot (cm)"}'
    - '// @input float tableDistanceMax = 250 {"hint":"Farthest a table center may be from the start spot (cm). ShakeOut: do not run far."}'
    - '// @input float hazardDistanceMin = 140 {"hint":"Closest any other item center (hazards, bed, chair) may be to the start spot (cm)"}'
    - '// @input float hazardDistanceMax = 300 {"hint":"Farthest any other item center (hazards, bed, chair) may be from the start spot (cm)"}'
    - '// @input float tableCountMin = 1 {"hint":"Fewest tables per drill (1 or 2)"}'
    - '// @input float tableCountMax = 2 {"hint":"Most tables per drill (1 or 2)"}'
    - '// @input float hazardCountMin = 3 {"hint":"Fewest hazards per drill, drawn from cabinet, shelf, glass, lamp, TV"}'
    - '// @input float hazardCountMax = 5 {"hint":"Most hazards per drill (no kind twice, so at most 5)"}'
    - '// @input float dangerMargin = 60 {"hint":"Danger zone = hazard footprint grown by this margin (cm)"}'
    - '// @input float startClearRadius = 50 {"hint":"No furniture or danger zone within this radius of the start spot (cm)"}'
    - '// @input float layoutSeed {"hint":"0 = new random layout every start and Restart; any other number = the same layout every time (for filming)"}'
    - '// @input float tableSwitchHysteresis = 30 {"hint":"The arrow switches to another table only when it is this much nearer (cm)"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Bed and fair score"}'
    - '// @input float bedWarnMargin = 30 {"hint":"Ducking within the bed footprint grown by this shows the bed warning (cm)"}'
    - '// @input float bedWarnSeconds = 2.5 {"hint":"How long the bed warning stays up, in seconds"}'
    - '// @input float walkSpeed = 100 {"hint":"Walking speed for the fair score: nearest table distance ÷ this is forgiven from tSafe (cm/s)"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Scan, path and edge warning (Slice 7B)"}'
    - '// @input float scanSeconds = 3 {"hint":"Scan intro length at the start of BRIEFING, in seconds. The quake wait starts after it."}'
    - '// @input float pathSpacing = 25 {"hint":"Floor path chevron spacing (cm)"}'
    - '// @input float pathLift = 2 {"hint":"Floor path height above the floor (cm)"}'
    - '// @input float pathMarchSpeed = 60 {"hint":"Chevrons march toward the table at this speed during the quake (cm/s)"}'
    - '// @input float pathFaintOpacity = 0.35 {"hint":"Floor path opacity during BRIEFING (0 to 1); full during the quake"}'
    - '// @input float edgePulseHz = 1.5 {"hint":"Red edge warning pulse while health drains, in Hz"}'
    - '// @input float edgeClearFraction = 0.7 {"hint":"Share of the view, per axis, the edge warning leaves clear in the middle (0 to 1)"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Levels (Slice 7C, ENGINEERING_PLAN 5j item 18)"}'
    - '// @input float easyTableMax = 150 {"hint":"Easy: farthest a table center may be from the start spot (cm)"}'
    - '// @input float normalAftershockChance = 0.5 {"hint":"Normal: chance of an aftershock after the main quake (0 to 1). Easy never, Hard always."}'
    - '// @input float hardDrainMultiplier = 1.5 {"hint":"Hard: health drains this many times faster"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Aftershock (Slice 7C, ENGINEERING_PLAN 5j item 7)"}'
    - '// @input float aftershockDelayMin = 2 {"hint":"Shortest quiet wait after leaving the zone before the aftershock, in seconds"}'
    - '// @input float aftershockDelayMax = 6 {"hint":"Longest quiet wait after leaving the zone before the aftershock, in seconds"}'
    - '// @input float aftershockDurationMin = 10 {"hint":"Shortest aftershock, in seconds"}'
    - '// @input float aftershockDurationMax = 20 {"hint":"Longest aftershock, in seconds"}'
    - "// @input float aftershockStrength = 0.6 {\"hint\":\"Aftershock shake as a share of the main quake's amplitude and tilt (0 to 1)\"}"
    - '// @input float aftershockGraceSeconds = 5 {"hint":"Aftershock: seconds after it starts before not being safe drains health (it drains sooner once under cover again), 5j-19c"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Falling objects (Slice 7D, ENGINEERING_PLAN 5j items 8, 17e)"}'
    - '// @input float fallCountMin = 1 {"hint":"Fewest items that fall during each quake and aftershock (Normal and Hard; Easy has none)"}'
    - '// @input float fallCountMax = 3 {"hint":"Most items that fall during each quake and aftershock"}'
    - '// @input float fallMarginSeconds = 3 {"hint":"Items fall no sooner than this after the shake starts and no later than this before it ends, in seconds"}'
    - '// @input float fallHitRadius = 40 {"hint":"An item landing within this distance (XZ) of the head hits it, unless the head is safe under a table (cm)"}'
    - '// @input float fallHitDamage = 15 {"hint":"Health lost when an item hits the head (points)"}'
    - '// @input float fallNoticeSeconds = 2 {"hint":"How long the hit.fell notice stays up, in seconds"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Evacuation (Slice 8B, ENGINEERING_PLAN 5k item 8)"}'
    - '// @input float evacSeconds = 30 {"hint":"Time to reach the door after the last shake before the evacuation fails, in seconds"}'
    - '// @input float evacDoorOffset = 40 {"hint":"The floor path and arrow aim at a point this far in front of the door (cm)"}'
    - '// @input float tripRadius = 25 {"hint":"Stepping within this distance (XZ) of a fallen item is a trip (cm)"}'
    - '// @input float tripDamage = 10 {"hint":"Health lost per trip, once per item (points)"}'
    - '// @input float tripNoticeSeconds = 2 {"hint":"How long the warn.trip notice stays up, in seconds"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Hold on (Slice 8B, ENGINEERING_PLAN 5k item 9)"}'
    - '// @input float gripGraceSeconds = 3 {"hint":"Normal and Hard: safe but not holding the table leg longer than this starts the grip drain, in seconds"}'
    - '// @input float gripDrainPerSecond = 1 {"hint":"Health lost per second while safe and not holding (points per second). Never stacks: the bigger drain wins."}'
    - '// @input float gripHandleSize = 8 {"hint":"Grip handle marker size (cm)"}'
    - '// @input float gripHandleHeight = 40 {"hint":"Grip handle height above the floor (cm)"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Test hooks"}'
    - '// @input bool testMode {"hint":"Short wait and short quake for LEAF scenarios. Off in the real drill."}'
    - '// @input float testWaitSeconds = 1 {"hint":"Wait before the quake when testMode is on, in seconds"}'
    - '// @input float testDurationSeconds = 8 {"hint":"Quake duration when testMode is on, in seconds"}'
    - '// @input float testScanSeconds = 0.5 {"hint":"Scan intro length when testMode is on, in seconds"}'
    - '// @input float testAftershockDelaySeconds = 0.5 {"hint":"Quiet wait before the aftershock when testMode is on, in seconds"}'
    - '// @input float testAftershockDurationSeconds = 4 {"hint":"Aftershock duration when testMode is on, in seconds"}'
    - '// @input float testAftershockGraceSeconds = 1 {"hint":"Aftershock grace (aftershockGraceSeconds) when testMode is on, in seconds"}'
    - '// @input float testEvacSeconds = 6 {"hint":"Evacuation time (evacSeconds) when testMode is on, in seconds"}'
    - '// @input float testGripGraceSeconds = 0.5 {"hint":"Grip grace (gripGraceSeconds) when testMode is on, in seconds"}'
